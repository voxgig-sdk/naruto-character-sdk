# Entity: character

main: kit: entity: character: {

  alias: field: {}

  fields: [
    {
      name: "debut"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "family"
      req: false
      short: "Character's family members and relationships"
      type: "`$OBJECT`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the character"
      type: "`$INTEGER`"
    }
    {
      name: "images"
      req: false
      short: "URLs to character images"
      type: "`$ARRAY`"
    }
    {
      name: "jutsu"
      req: false
      short: "List of jutsus the character can perform"
      type: "`$ARRAY`"
    }
    {
      name: "name"
      req: false
      short: "Character's name"
      type: "`$STRING`"
    }
    {
      name: "natureType"
      req: false
      short: "Character's chakra nature types"
      type: "`$ARRAY`"
    }
    {
      name: "personal"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "rank"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "uniqueTraits"
      req: false
      short: "Character's unique traits or abilities"
      type: "`$ARRAY`"
    }
    {
      name: "voiceActors"
      req: false
      type: "`$OBJECT`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "character"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: 20
                kind: "query"
                name: "limit"
                orig: "limit"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "name"
                orig: "name"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/character"
          parts: [
            "character"
          ]
          select: {
            exist: [
              "limit"
              "name"
              "page"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.characters`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/character/{id}"
          parts: [
            "character"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
