# Entity: character

main: kit: entity: character: {

  alias: field: {}

  fields: {
    debut: {
      h: "Debut"
      n: "debut"
      r: false
      t: "`$OBJECT`"
    }
    family: {
      h: "Family"
      n: "family"
      r: false
      sh: "Character's family members and relationships"
      t: "`$OBJECT`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique identifier for the character"
      t: "`$INTEGER`"
    }
    images: {
      h: "Images"
      n: "images"
      r: false
      sh: "URLs to character images"
      t: "`$ARRAY`"
    }
    jutsu: {
      h: "Jutsu"
      n: "jutsu"
      r: false
      sh: "List of jutsus the character can perform"
      t: "`$ARRAY`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "Character's name"
      t: "`$STRING`"
    }
    natureType: {
      h: "Nature Type"
      n: "natureType"
      r: false
      sh: "Character's chakra nature types"
      t: "`$ARRAY`"
    }
    personal: {
      h: "Personal"
      n: "personal"
      r: false
      t: "`$OBJECT`"
    }
    rank: {
      h: "Rank"
      n: "rank"
      r: false
      t: "`$OBJECT`"
    }
    uniqueTraits: {
      h: "Unique Traits"
      n: "uniqueTraits"
      r: false
      sh: "Character's unique traits or abilities"
      t: "`$ARRAY`"
    }
    voiceActors: {
      h: "Voice Actors"
      n: "voiceActors"
      r: false
      t: "`$OBJECT`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "character"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /character"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: 20
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "name"
                or: "name"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/character"
          q: {
            exist: [
              "limit"
              "name"
              "page"
            ]
          }
          s: [
            {
              lit: "character"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.characters`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /character/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/character/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "character"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
